# Scorpion.ai configuration — copy to ".env" and fill in.
# .env is git-ignored; never commit real secrets.

# --- Brain (Claude API) -----------------------------------------------------
# Without a key, Scorpion still runs in deterministic-planner mode (no LLM).
ANTHROPIC_API_KEY=
# Model ids depend on what your Anthropic account exposes; override if needed.
SCORPION_MODEL=claude-sonnet-5-5
SCORPION_HEAVY_MODEL=claude-opus-5-5
# Set to 1 to force the no-LLM planner even when a key is present.
SCORPION_NO_LLM=

# --- Scope Guard (REQUIRED to scan anything) --------------------------------
# Comma-separated. The agent refuses every target until this is set (fail-closed).
#   example.com         -> apex + all subdomains
#   *.example.com       -> subdomains only
#   203.0.113.0/24      -> a CIDR range
SCORPION_SCOPE=
# Optional explicit out-of-scope entries (deny always wins):
SCORPION_SCOPE_DENY=

# --- Politeness / safety ----------------------------------------------------
SCORPION_RATE_PER_HOST=8
SCORPION_MAX_STEPS=40
SCORPION_MAX_TOOL_SECONDS=600

# --- Notifications ----------------------------------------------------------
# Create a bot with @BotFather, then message it once and read your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Local voice (espeak/piper/say) + Telegram voice notes. 1/0.
SCORPION_VOICE=1

# --- Dashboard --------------------------------------------------------------
# Keep 127.0.0.1 and reach it over an SSH tunnel; do NOT expose it to the net.
SCORPION_HOST=127.0.0.1
SCORPION_PORT=8778
